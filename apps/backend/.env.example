# ─── Server ────────────────────────────────────────────────────────────────────
HOST=0.0.0.0
# Backend HTTP/WS port. Uses BACKEND_PORT (not generic PORT) so dev tooling that
# injects PORT can't steal it. The Vite proxy targets 3001.
BACKEND_PORT=3001
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info
NODE_ENV=development

# ─── IBKR TWS / IB Gateway connection ─────────────────────────────────────────
# TWS paper trading:    port 7497
# TWS live trading:     port 7496
# IB Gateway paper:     port 4002
# IB Gateway live:      port 4001
IBKR_HOST=127.0.0.1
IBKR_PORT=7497

# Each running instance of this backend needs a unique client ID (0–32)
IBKR_CLIENT_ID=1

# Reconnect settings
IBKR_RECONNECT_DELAY=5000    # Initial delay in ms (doubles each attempt)
IBKR_MAX_RECONNECTS=10
